{
  "global": {
    "description": "全局设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用群管验证",
        "type": "bool",
        "default": true,
        "hint": "总开关，关闭后所有群的入群申请验证与入群后验证都不执行"
      },
      "notify_group": {
        "description": "通知群号（二次验证）",
        "type": "string",
        "default": "",
        "hint": "群成员验证失败触发「二次验证」时，把提醒发送到这个群，例如 123456789。留空则退化为私聊群主/管理员"
      },
      "notify_group_template": {
        "description": "通知群消息模板",
        "type": "text",
        "default": "qq:{user_id} 回答错误，注意处理\n━━━━━━━━━━━━━━\n群号：{group_id}\n昵称：{user_name}\n题目：{question}\n回答：{answer}\n原因：{reason}\n时间：{time}\n本群执行情况：{action_note}\n（机器人角色：{bot_role}）\n━━━━━━━━━━━━━━\n管理员可在本群使用：\n/通过验证 {user_id}  ← 解除禁言\n/拒绝验证 {user_id}  ← 移出群聊",
        "hint": "可用变量：{user_id} {user_name} {group_id} {question} {answer} {reason} {time} {mute_seconds} {attempts} {bot_role} {action_note}。{action_note} 会如实说明原群禁言/踢出是否真的执行成功"
      },
      "notify_owner_admin": {
        "description": "无通知群时私聊群主/管理员",
        "type": "bool",
        "default": true,
        "hint": "未配置通知群、或通知群发送失败时，退化为私聊该群的群主与管理员"
      },
      "default_provider_id": {
        "description": "AI 判定使用的模型",
        "type": "string",
        "_special": "select_provider",
        "default": "",
        "hint": "留空使用当前默认对话模型"
      }
    }
  },
  "group_custom_configs": {
    "description": "群自定义配置",
    "type": "template_list",
    "hint": "为指定群覆盖全局默认参数；未列出的群直接使用全局默认",
    "default": [],
    "templates": {
      "group_config": {
        "name": "QQ群",
        "hint": "为指定群设置独立的验证参数",
        "display_item": "group_id",
        "items": {
          "group_id": {
            "description": "群号",
            "type": "string",
            "hint": "仅允许数字，例如 123456789"
          },
          "follow_default": {
            "description": "跟随全局默认",
            "type": "bool",
            "default": false,
            "hint": "开启后忽略本群下方配置，直接使用全局默认配置"
          },
          "join_request_verification": {
            "description": "入群申请验证",
            "type": "object",
            "items": {
              "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
              },
              "answer_pattern": {
                "description": "答案正则",
                "type": "string",
                "default": "\\w+\\s*#\\s*\\d+",
                "hint": "对入群申请附言做全匹配判断的正则，例如游戏名#数字：\\w+\\s*#\\s*\\d+"
              },
              "pattern_ignore_case": {
                "description": "正则忽略大小写",
                "type": "bool",
                "default": true
              },
              "use_llm": {
                "description": "启用 AI 判定",
                "type": "bool",
                "default": false,
                "hint": "正则未通过、或需要结合等级与留言综合判断时，交给大模型判断是否为广告人机"
              },
              "llm_mode": {
                "description": "AI 判定时机",
                "type": "string",
                "default": "正则不通过时",
                "options": ["正则不通过时", "始终由AI判定", "仅AI判定"],
                "hint": "仅AI判定：跳过正则，完全由大模型决定是否放行"
              },
              "llm_prompt": {
                "description": "AI 判定提示词",
                "type": "text",
                "default": "你是QQ游戏群的入群审核助手，需要判断申请人是真实玩家还是广告机器人。\n\n申请人：{user_name}（{user_id}）\n等级：{level}\n申请附言：{answer}\n\n群规要求：入群附言必须是「游戏名称#数字后缀」的形式，例如「娜娜#123」。\n请综合等级高低与附言内容判断：\n- 附言符合格式且像真实玩家 → 放行\n- 附言是广告、灌水、无意义字符，或等级为0疑似新注册小号且附言可疑 → 拒绝\n\n只输出一个词：PASS 或 REJECT",
                "hint": "可用变量：{user_id} {user_name} {level} {answer} {group_id} {group_name} {comment}"
              },
              "llm_fallback": {
                "description": "AI 判定失败时",
                "type": "string",
                "default": "按正则结果处理",
                "options": ["按正则结果处理", "拒绝", "放行"],
                "hint": "模型超时、报错或输出无法识别时如何处理"
              },
              "llm_timeout": {
                "description": "AI 判定超时",
                "type": "int",
                "default": 20,
                "slider": {"min": 5, "max": 60, "step": 5},
                "hint": "单位：秒"
              },
              "reject_reason": {
                "description": "拒绝申请理由",
                "type": "string",
                "default": "答案格式不正确，请按「游戏名称#数字」填写后重新申请",
                "hint": "通过 set_group_add_request 回传给申请人的拒绝理由"
              },
              "reject_reply": {
                "description": "拒绝后自动回复内容",
                "type": "text",
                "default": "{user_name}，你的入群申请未通过。\n原因：{reason}\n正确格式示例：娜娜#123\n请修改附言后重新申请，谢谢配合。",
                "hint": "可用变量：{user_name} {user_id} {reason} {group_id} {answer}。优先私聊发送，失败则记录日志"
              },
              "reject_private": {
                "description": "拒绝时尝试私聊回复",
                "type": "bool",
                "default": true,
                "hint": "陌生人私聊通常会被平台拦截，失败不影响拒绝动作"
              },
              "reject_blacklist": {
                "description": "拒绝并拉黑",
                "type": "bool",
                "default": false,
                "hint": "开启后管理员需重新审核该用户才能再次申请"
              },
              "reject_level_below": {
                "description": "低等级直接拒绝",
                "type": "int",
                "default": 0,
                "hint": "0 表示不限制；例如填 8 则等级低于 8 的申请直接拒绝，不进入正则与 AI 判定"
              }
            }
          },
          "member_verification": {
            "description": "入群后算术验证",
            "type": "object",
            "items": {
              "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
              },
              "verify_timeout": {
                "description": "每题等待时间",
                "type": "int",
                "default": 120,
                "slider": {"min": 30, "max": 600, "step": 10},
                "hint": "单位：秒，超时按一次失败处理"
              },
              "max_attempts": {
                "description": "最大尝试次数",
                "type": "int",
                "default": 3,
                "slider": {"min": 1, "max": 10, "step": 1},
                "hint": "单位：次，用尽后触发失败处理"
              },
              "difficulty": {
                "description": "题目难度",
                "type": "string",
                "default": "简单（10以内加减）",
                "options": ["简单（10以内加减）", "中等（100以内加减）", "较难（两位数混合）"],
                "hint": "群成员验证建议使用「简单（10以内加减）」"
              },
              "allow_subtract_negative": {
                "description": "允许减法结果为负",
                "type": "bool",
                "default": false,
                "hint": "关闭后被减数一定大于减数，答案非负"
              },
              "question_format": {
                "description": "题目文本",
                "type": "string",
                "default": "请回答以下验证题，{timeout} 秒内发送答案（共 {max_attempts} 次机会）：\n{question} = ?",
                "hint": "可用变量：{question} {timeout} {max_attempts}"
              },
              "at_member": {
                "description": "题目中@该成员",
                "type": "bool",
                "default": true
              },
              "success_reply": {
                "description": "验证成功回复",
                "type": "string",
                "default": "验证通过，欢迎加入本群！",
                "hint": "留空则不发送"
              },
              "wrong_reply": {
                "description": "答错回复",
                "type": "string",
                "default": "回答错误，还有 {remaining} 次机会。\n{question} = ?",
                "hint": "可用变量：{remaining} {question} {attempts} {max_attempts}"
              },
              "timeout_reply": {
                "description": "超时回复",
                "type": "string",
                "default": "等待超时，还有 {remaining} 次机会。\n{question} = ?",
                "hint": "可用变量：{remaining} {question} {attempts} {max_attempts}；留空则只为下一题发送题目"
              },
              "non_number_reply": {
                "description": "非数字回复",
                "type": "string",
                "default": "请只发送数字答案，例如 12",
                "hint": "发送非数字内容时的提示"
              },
              "count_non_number": {
                "description": "非数字内容计入次数",
                "type": "bool",
                "default": false,
                "hint": "关闭时发送非数字内容不消耗尝试次数"
              },
              "skip_admins": {
                "description": "跳过管理员与群主",
                "type": "bool",
                "default": true
              },
              "join_delay": {
                "description": "入群后延迟出题",
                "type": "int",
                "default": 3,
                "slider": {"min": 0, "max": 30, "step": 1},
                "hint": "单位：秒，避免成员刚入群时无法发送/接收消息"
              }
            }
          },
          "fail_action": {
            "description": "验证失败处理",
            "type": "object",
            "items": {
              "action": {
                "description": "处理方式",
                "type": "string",
                "default": "二次验证",
                "options": ["禁言", "踢出", "二次验证"],
                "hint": "禁言：群内禁言一定时间；踢出：直接移出群聊；二次验证：禁言并在通知群提醒管理员处理"
              },
              "mute_seconds": {
                "description": "禁言时长",
                "type": "int",
                "default": 600,
                "slider": {"min": 0, "max": 2592000, "step": 60},
                "hint": "单位：秒，仅「禁言」与「二次验证」生效；0 表示永久禁言"
              },
              "kick_blacklist": {
                "description": "踢出时拉黑",
                "type": "bool",
                "default": false,
                "hint": "仅「踢出」生效"
              },
              "mute_reply": {
                "description": "禁言提示",
                "type": "string",
                "default": "{user_name} 验证失败，已被禁言 {mute_seconds} 秒。",
                "hint": "可用变量：{user_name} {user_id} {mute_seconds} {question} {answer}"
              },
              "kick_reply": {
                "description": "踢出提示",
                "type": "string",
                "default": "{user_name} 验证失败，已被移出本群。",
                "hint": "可用变量：{user_name} {user_id} {question} {answer}"
              },
              "secondary_group_reply": {
                "description": "二次验证群内提示",
                "type": "string",
                "default": "{user_name} 验证失败，已禁言并提交管理员二次验证。",
                "hint": "可用变量：{user_name} {user_id} {mute_seconds}"
              },
              "secondary_notify_errors_only": {
                "description": "仅答错时通知",
                "type": "bool",
                "default": false,
                "hint": "开启后超时未作答不通知通知群"
              },
              "admin_decision_timeout": {
                "description": "管理员处理超时",
                "type": "int",
                "default": 300,
                "slider": {"min": 0, "max": 3600, "step": 30},
                "hint": "单位：秒，超时后自动执行兜底处理；0 表示不超时"
              },
              "decision_timeout_action": {
                "description": "超时兜底处理",
                "type": "string",
                "default": "保持禁言",
                "options": ["保持禁言", "踢出", "解除禁言"]
              },
              "notify_group_override": {
                "description": "本群专用通知群号",
                "type": "string",
                "default": "",
                "hint": "留空使用全局通知群号"
              }
            }
          }
        }
      }
    }
  },
